# Copy to .env.local and restart the Next.js server after editing.
# Optional Next output directory; default .next. Keep compiled outputs inside
# apps/web so their modules can resolve the project's node_modules.
# For low disk space, move only a build directory's cache subdirectory externally;
# do not point the complete dist directory at an unrelated external-drive folder.
# ASMR_NEXT_DIST_DIR=.next-spatial

# Planner uses local Ollama by default. Start Ollama and download this model first:
# ollama pull qwen3:1.7b
ASMR_PLANNER_DEFAULT_PROVIDER=ollama
ASMR_PLANNER_OLLAMA_URL=http://127.0.0.1:11434
ASMR_PLANNER_OLLAMA_MODEL=qwen3:1.7b
# Context is clamped to 4096..32768; larger contexts use more memory.
ASMR_PLANNER_OLLAMA_CONTEXT=8192
# -1 lets Ollama choose GPU layers; 0 explicitly uses CPU (slower).
# There is no automatic hardware or provider fallback after failure.
ASMR_PLANNER_OLLAMA_NUM_GPU=-1

# Optional OpenAI-compatible Chat Completions provider (for example DeepSeek).
# Set all three values to enable it. URL is the API base, including /v1 if required.
# The configured model must support response_format: { type: "json_object" }.
# Credentials stay on the server; never prefix these with NEXT_PUBLIC_.
ASMR_PLANNER_API_URL=
ASMR_PLANNER_API_KEY=
ASMR_PLANNER_API_MODEL=

# Total generation + optional single repair timeout. Clamped to 10..600 seconds.
ASMR_PLANNER_TIMEOUT_SECONDS=300

# Optional local VoxCPM2 native CLI voice provider. The profile contains server-only
# executable/model/reference paths; no credentials are needed for local generation.
# Default: <ASMR_DIRECTOR_RUNTIME_ROOT>/audio-quality-v1/voxcpm2/profile.json
# ASMR_VOXCPM2_PROFILE_PATH=D:\CodexWorkplace\asmr_director_runtime\audio-quality-v1\voxcpm2\profile.json

# Optional local long-text ASR. Uses offline faster-whisper large-v3 on CPU/int8;
# no model download, external ASR request, or extra HTTP service is started.
# Without an override, try audio-quality-v1/.venv/Scripts/python.exe, then the
# working GPT-SoVITS env-comfyui-clone/python.exe under the runtime root.
# Required imports: faster_whisper, numpy, scipy, soundfile, opencc.OpenCC.
# ASMR_VOICE_ANALYSIS_PYTHON=D:\CodexWorkplace\asmr_director_runtime\engines\gpt-sovits\env-comfyui-clone\python.exe
# ASMR_VOICE_ANALYSIS_MODEL=D:\CodexWorkplace\asmr_director_runtime\engines\gpt-sovits\GPT-SoVITS\tools\asr\models\faster-whisper-large-v3
# New native/ASR scratch files and complete originals; legacy traces stay readable.
# ASMR_VOICE_WORK_ROOT=I:/AI/asmr-director-voice-work
# auto enables one-TTS/one-ASR overlap only with >=8 GiB free RAM and >=8 CPUs.
# ASMR_VOICE_PIPELINE=auto
# auto reuses one CPU ASR model with >=8 GiB free, releasing below 6 GiB.
# ASMR_VOICE_ASR_REUSE=auto
# Long-text semantic analysis defaults to local Ollama. Selecting external API
# explicitly reuses ASMR_PLANNER_API_* above and sends the current spoken text.

# Original D binaural voice preview/mix. No additional HTTP service is required.
# Python imports: numpy, scipy, soundfile, h5py, pyloudnorm.
# Defaults below use <ASMR_DIRECTOR_RUNTIME_ROOT> (this host defaults to
# D:/CodexWorkplace/asmr_director_runtime). Keep all runtime assets outside Git.
# ASMR_SPATIAL_PYTHON=D:/CodexWorkplace/asmr_director_runtime/audio-quality-v1/.venv/Scripts/python.exe
# ASMR_SPATIAL_HRTF=D:/CodexWorkplace/asmr_director_runtime/audio-quality-v1/hrtf/viking/subj_A.sofa
# Default spatial cache: <ASMR_DIRECTOR_RUNTIME_ROOT>/assets/spatial.
# Unlike compiled Next outputs, this derived audio cache can be on another drive.
# ASMR_SPATIAL_CACHE_ROOT=I:/AI/asmr-director-runtime/assets/spatial
# HRTF: Viking Dataset v2, Spagnol/Miccini/Unnthorsson (2020), CC BY 4.0.
# Dataset and attribution: https://doi.org/10.5281/zenodo.4160401
