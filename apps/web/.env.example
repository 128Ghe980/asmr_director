# Copy to .env.local and restart the Next.js server after editing.
# Planner uses local Ollama by default. Start Ollama and download this model first:
# ollama pull qwen3:1.7b
ASMR_PLANNER_DEFAULT_PROVIDER=ollama
ASMR_PLANNER_OLLAMA_URL=http://127.0.0.1:11434
ASMR_PLANNER_OLLAMA_MODEL=qwen3:1.7b
# Context is clamped to 4096..32768; larger contexts use more memory.
ASMR_PLANNER_OLLAMA_CONTEXT=8192
# -1 lets Ollama choose GPU layers; 0 explicitly uses CPU (slower).
# There is no automatic hardware or provider fallback after failure.
ASMR_PLANNER_OLLAMA_NUM_GPU=-1

# Optional OpenAI-compatible Chat Completions provider (for example DeepSeek).
# Set all three values to enable it. URL is the API base, including /v1 if required.
# The configured model must support response_format: { type: "json_object" }.
# Credentials stay on the server; never prefix these with NEXT_PUBLIC_.
ASMR_PLANNER_API_URL=
ASMR_PLANNER_API_KEY=
ASMR_PLANNER_API_MODEL=

# Total generation + optional single repair timeout. Clamped to 10..600 seconds.
ASMR_PLANNER_TIMEOUT_SECONDS=300
